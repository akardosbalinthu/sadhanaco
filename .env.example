# Másold le .env.local néven, és töltsd ki. A .env.local soha ne kerüljön a repóba.

# --- Supabase ---
# Helyi fejlesztéshez: `npx supabase status` kiírja az értékeket.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Csak szerveroldalon (webhookok, cron, belső API). Soha ne kerüljön kliensre.
SUPABASE_SERVICE_ROLE_KEY=

# --- Alkalmazás ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (2. fázis) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Számlázz.hu Agent API (2. fázis) ---
SZAMLAZZ_AGENT_KEY=

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@akardosbalint.hu

# --- Bunny.net (média) ---
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_TOKEN_AUTH_KEY=

# --- Belső ökoszisztéma (Privát Közlöny) ---
INTERNAL_API_SECRET=

# --- Vercel Cron ---
CRON_SECRET=
