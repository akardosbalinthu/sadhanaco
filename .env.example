# Másold le .env.local néven, és töltsd ki. A .env.local soha ne kerüljön a repóba.

# --- Supabase ---
# Helyi fejlesztéshez: `npx supabase status` kiírja az értékeket.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Csak szerveroldalon (webhookok, cron, belső API). Soha ne kerüljön kliensre.
SUPABASE_SERVICE_ROLE_KEY=

# --- Alkalmazás (egy app: akardosbalint.hu + tarsasag.akardosbalint.hu) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Helyben a Társaság a /tarsasag útvonalon fut; élesben aldomainen
# (az útvonal-előtag ebből az URL-ből származik):
#   NEXT_PUBLIC_TARSASAG_URL=https://tarsasag.akardosbalint.hu
NEXT_PUBLIC_TARSASAG_URL=http://localhost:3000/tarsasag
# Online fizetés csak a Stripe webhook élesítése után (2. fázis) kapcsolható be.
ONLINE_PAYMENTS_ENABLED=false

# --- Stripe (éles fiók: akardosbalint.hu; árak lookup_key = price_catalog.code) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Számlázás (2. fázis) ---
# A szolgáltató az adatbázisban választható: app_settings.invoice_provider (alapértelmezés: billingo).
BILLINGO_API_KEY=
# Billingo számlatömb azonosító (block_id) és bankszámla azonosító
BILLINGO_BLOCK_ID=
BILLINGO_BANK_ACCOUNT_ID=

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=balint@akardosbalint.hu

# --- Bunny.net (média) ---
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_TOKEN_AUTH_KEY=

# --- Belső ökoszisztéma (Napi Közlöny) ---
INTERNAL_API_SECRET=

# --- Vercel Cron ---
CRON_SECRET=
